#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  ssh:
    install-server: true
    # Password SSH login is disabled -- auth is via the injected key below.
    # The account password (set under identity) still works for local
    # console login (VirtualBox GUI) and for sudo prompts inside a session.
    allow-pw: false
    authorized-keys:
      - INSERT_SSH_KEY_HERE
  identity:
    hostname: sre-node-01
    username: sysadmin
    # Password is "sysadmin" -- console/sudo fallback only, see TROUBLESHOOTING.md #10
    password: "$6$rounds=656000$Mip5VLtMEH/QG37A$bAN6fRqRU0acSLysrt45xvohtlBT0W.qwh3kbG9i9FrX5Is1Rxep9RxGHFfTjzVC/t4h2l97Sw2SI4W5jDDJp1"

  storage:
    layout:
      name: direct
      match:
        size: largest

  grub_dpkg:
    enabled: true
    grub_pc_install_devices:
      - /dev/sda

  # Keeps the *installation* off the network mirrors, which is what fixes the
  # silent apt hang in TROUBLESHOOTING.md #4. It is an install-time measure only
  # -- late-commands below put both suites back before first boot.
  apt:
    disable_suites: [updates, security]

  late-commands:
    # disable_suites is not scoped to the installer: it is written through to the
    # installed system's sources, and left alone the node would never receive a
    # security update. It also breaks ordinary package installs -- a point-release
    # ISO carries packages from noble-updates, so their exact versions become
    # unresolvable once that suite is gone, and anything depending on them fails
    # with "held broken packages". Restored here rather than by dropping
    # disable_suites, because the install must stay offline for #4.
    # Each command ends in `exit 0`: a failing late-command aborts the whole
    # unattended install, and no repair of sources is worth that.
    - 'curtin in-target --target=/target -- sh -c "sed -i ''s/^Suites: noble noble-backports$/Suites: noble noble-updates noble-backports/'' /etc/apt/sources.list.d/ubuntu.sources; exit 0"'
    - 'curtin in-target --target=/target -- sh -c "grep -q noble-security /etc/apt/sources.list.d/ubuntu.sources || printf ''\nTypes: deb\nURIs: http://security.ubuntu.com/ubuntu/\nSuites: noble-security\nComponents: main universe restricted multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n'' >> /etc/apt/sources.list.d/ubuntu.sources; exit 0"'

    # Power off the VM when installation is complete
    - "poweroff"
